ENVIRONMENT=local
PROJECT_NAME=OSeMOSYS API
API_V1_STR=/api/v1
LOG_LEVEL=INFO

# Orígenes permitidos por CORS.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Base de datos y Redis (en Docker se sobreescriben por docker-compose).
DATABASE_URL=postgresql+psycopg://osemosys:osemosys@db:5432/osemosys
DB_SCHEMA_OSEMOSYS=osemosys
REDIS_URL=redis://redis:6379/0

# Simulación
# Este archivo controla ejecución directa desde `backend/` y sirve como env_file.
# Con el compose raíz, las variables SIM_* declaradas en docker-compose.yml se
# interpolan desde `../.env`/shell y sobrescriben estos valores.
SIM_WORKER_REPLICAS=1
SIM_MAX_CONCURRENCY=1
SIM_USER_ACTIVE_LIMIT=3
SIM_TOTAL_WEIGHT_LIMIT=8
SIM_WEIGHT_NATIONAL=1
SIM_WEIGHT_REGIONAL=3
# 0 hilos = default HiGHS (mismo comportamiento que el notebook).
SIM_SOLVER_THREADS=0
# Perfiles HiGHS: default|balanced|fast|memory. No fijan threads; combínalos con SIM_SOLVER_THREADS.
SIM_SOLVER_PROFILE=default
# Dejar vacío = no forzar método/presolve/parallel/crossover (HiGHS elige, ~simplex).
# SIM_SOLVER_HIGHS_METHOD=
# SIM_SOLVER_HIGHS_PRESOLVE=
# SIM_SOLVER_HIGHS_PARALLEL=
# SIM_SOLVER_HIGHS_HIPO_PARALLEL_TYPE=
# SIM_SOLVER_HIGHS_CROSSOVER=
# Opciones avanzadas HiGHS para experimentos, JSON objeto. Ej: {"user_bound_scale":-37}
# SIM_SOLVER_HIGHS_OPTIONS_JSON=
SIM_SOLVER_HIGHS_DIRECT=true
# Opcionales (solo si eliges method=ipm desde admin o env):
# SIM_SOLVER_HIGHS_TIME_LIMIT=0
# SIM_SOLVER_HIGHS_IPM_TOL=1e-7
# SIM_SOLVER_HIGHS_PRIMAL_TOL=1e-7
# GLPK: fast=A validado (primal+presolve), strict=B (simplex exacto).
SIM_SOLVER_GLPK_PROFILE=fast
SIM_SOLVER_GLPK_TIME_LIMIT=0
SIM_SOLVER_GLPK_OPTIONS_JSON=
OSEMOSYS_FAST_DATAPORTAL=1
# 0 desactiva; 0.001 alinea mínimos pequeños con el comportamiento notebook/GLPK.
OSEMOSYS_ACTIVITY_LOWER_PRUNE_TOL=0
# 1 evita productos cartesianos temporales; 0 conserva algoritmo legacy notebook.
OSEMOSYS_SPARSE_MATRIX_PREPROCESS=1
# 1 almacena sólo índices no-default en parámetros de 4-5 dimensiones.
OSEMOSYS_SPARSE_HIGH_DIM_PARAMS=1
# 1 elimina variables/ecuaciones de penalización donde EmissionsPenalty=0.
OSEMOSYS_SPARSE_EMISSION_PENALTIES=1
# 1 habilita el reporte detallado de Pyomo; mantener 0 en producción.
OSEMOSYS_PYOMO_REPORT_TIMING=0

# Activa estos flags para compilar highspy desde fuente con soporte HiPO.
# Para usar SIM_SOLVER_HIGHS_METHOD=hipo, HIGHS_ENABLE_HIPO debe ser 1.
HIGHS_BUILD_FROM_SOURCE=0
HIGHS_GIT_REF=master
HIGHS_ENABLE_HIPO=0

# Perfil orientado a acelerar una simulación individual con HiGHS.
OMP_NUM_THREADS=6
OPENBLAS_NUM_THREADS=6
MKL_NUM_THREADS=6

# Seguridad (cambia en ambientes reales)
SECRET_KEY=replace-me-before-deploy
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Auditoría local de espacio en disco.
DISK_AUDIT_INTERVAL_HOURS=6
DISK_ALERT_THRESHOLDS_GB=60,50,40
DISK_AUDIT_CSV_PATH=/var/log/osemosys/disk_audit.csv
DISK_ALERT_LOG_PATH=/var/log/osemosys/disk_alerts.log

# Diagnóstico pre-solve de restricciones triviales (solo desarrollo; muy lento en modelos grandes).
# 0 = producción (default). 1 = activar reporte en logs del worker.
OSEMOSYS_CONSTRAINT_DIAGNOSTICS=0
